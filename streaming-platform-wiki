function buildCard(s){
    const c1=s.colors[0],c2=s.colors[1],isPiracy=s.type==='piracy',isDead=s.badge==='merged';
    let badges=`<span class="badge-${s.badge} font-mono text-[10px] px-2.5 py-1 rounded-full">${isDead?'💀 Dead':s.badge==='db'?'📊 Database':s.badge==='legal'?'✅ Legal':'❌ Piracy'}</span>`;
    if(s.extra==='clone')badges+=`<span class="badge-clone font-mono text-[10px] px-2.5 py-1 rounded-full">Clone</span>`;
    if(s.extra==='db')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-db font-mono text-[10px] px-2.5 py-1 rounded-full">DB</span></div>`;
    if(s.extra==='series')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-series font-mono text-[10px] px-2.5 py-1 rounded-full">Free</span></div>`;
    if(s.extra==='video')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-video font-mono text-[10px] px-2.5 py-1 rounded-full">Video</span></div>`;
    if(s.extra==='kdrama')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-kdrama font-mono text-[10px] px-2.5 py-1 rounded-full">K-Drama</span></div>`;
    if(s.extra==='games')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-games font-mono text-[10px] px-2.5 py-1 rounded-full">Web</span></div>`;
    if(s.extra==='store')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-store font-mono text-[10px] px-2.5 py-1 rounded-full">Store</span></div>`;
    if(s.extra==='deals')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-deals font-mono text-[10px] px-2.5 py-1 rounded-full">Deals</span></div>`;
    if(s.extra==='retro')badges=`<div class="flex gap-1.5"><span class="badge-legal font-mono text-[10px] px-2.5 py-1 rounded-full">✅ Legal</span><span class="badge-retro font-mono text-[10px] px-2.5 py-1 rounded-full">Retro</span></div>`;
    let warnHtml='';
    if(s.warn){const wI=isDead?'mdi:information':'mdi:alert-circle',wC=isDead?'amber':'red',wB=isDead?'bg-amber-500/5 border-amber-500/10':'bg-red-500/5 border-red-500/10';warnHtml=`<div class="${wB} border rounded-lg px-4 py-3 mb-4"><div class="flex items-start gap-2"><span class="iconify text-${wC}-400 text-sm mt-0.5 shrink-0" data-icon="${wI}"></span><div class="text-xs text-${wC}-300/80 leading-relaxed"><strong class="text-${wC}-300">${s.warn.split('.')[0]}.</strong>${s.warn.includes('.')?s.warn.substring(s.warn.indexOf('.')):''}</div></div></div>`}
    const dR=s.details.map(d=>`<div class="detail-row flex items-center gap-2 px-2.5 py-2 rounded-lg"><span class="iconify text-zinc-500" data-icon="${d[0]}"></span><span class="${d[2]==='red'?'text-red-400':'text-zinc-400'}">${d[1]}</span></div>`).join('');
    const lC=s.badge==='merged'?'rose':c1,lW=isDead&&s.lib===0?'0':s.lib,strike=isDead?'line-through text-zinc-500':'';
    const mu=s.multiUrls?`<div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-0.5">${s.multiUrls.map(u=>`<a href="${u}" target="_blank" rel="noopener" class="multi-url font-mono text-[10px]">${u.replace('https://www.youtube.com/','@').replace('https://','')} →</a>`).join('')}</div>`:'';
    return `<div class="site-card card-hover relative bg-white/[0.03] border border-white/[0.06] rounded-2xl overflow-hidden ${isPiracy&&!isDead?'piracy-warning':''}" data-name="${s.name.toLowerCase()}"><div class="card-glow"></div><div class="p-6 relative z-10"><div class="flex items-start justify-between mb-3"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-xl bg-gradient-to-br from-${c1}-500/20 to-${c2}-500/20 border border-${c1}-500/20 flex items-center justify-center"><span class="iconify text-${c1}-400 text-lg" data-icon="${s.icon}"></span></div><div><h3 class="font-semibold text-sm ${strike}">${s.name}</h3><a href="${s.url}" target="_blank" rel="noopener" class="font-mono text-[10px] text-indigo-400 hover:text-indigo-300 transition-colors">${s.url.replace('https://','').replace(/\/$/,'')} →</a>${mu}</div></div>${typeof badges==='string'?badges:badges}</div><p class="text-zinc-400 text-sm leading-relaxed mb-3">${s.desc}</p>${warnHtml}<div class="grid grid-cols-2 gap-2 text-xs">${dR}</div><div class="flex items-center gap-2 mt-4 pt-4 border-t border-white/5"><div class="flex-1"><div class="flex items-center justify-between mb-1"><span class="font-mono text-[10px] text-zinc-600">${isDead?'Status':'Library'}</span><span class="font-mono text-[10px] ${isDead?'text-rose-400':'text-zinc-400'}">${s.libLabel}</span></div><div class="w-full h-1 bg-white/5 rounded-full overflow-hidden"><div class="stat-bar h-full bg-${lC}-500/60 rounded-full" style="width:${lW}%"></div></div></div><a href="${s.url}" target="_blank" rel="noopener" class="ml-4 w-8 h-8 rounded-lg border border-white/10 flex items-center justify-center hover:bg-white/5 hover:border-white/20 transition-all" title="Visit ${s.name}"><span class="iconify text-zinc-400 text-sm" data-icon="mdi:open-in-new"></span></a></div></div></div>`;
}

function buildRankRow(s,i){
    const rank=i+1,rc=rank===1?'rank-1':rank===2?'rank-2':rank===3?'rank-3':'rank-default';
    const catL=s.cat==='anime'?'<span class="text-indigo-400 text-xs">Anime</span>':s.cat==='kdrama'?'<span class="text-pink-400 text-xs">K-Drama</span>':s.cat==='games'?'<span class="text-cyan-400 text-xs">Web</span>':s.cat==='downloads'?'<span class="text-orange-400 text-xs">Download</span>':'<span class="text-purple-400 text-xs">Series</span>';
    const tL=s.badge==='merged'?'<span class="badge-merged font-mono text-[10px] px-2 py-0.5 rounded-full">Dead</span>':s.badge==='db'?'<span class="badge-db font-mono text-[10px] px-2 py-0.5 rounded-full">DB</span>':s.type==='legal'?'<span class="badge-legal font-mono text-[10px] px-2 py-0.5 rounded-full">Legal</span>':'<span class="badge-piracy font-mono text-[10px] px-2 py-0.5 rounded-full">Piracy</span>';
    const sd={'a':'safety-a','b':'safety-b','c':'safety-c','d':'safety-d'}[s.safe],bc=s.badge==='merged'?'rose':s.colors[0];
    const sclr=s.score>=9?'text-yellow-400':s.score>=7?'text-zinc-300':s.score>=4?'text-zinc-400':'text-zinc-500';
    const rBg=s.type==='piracy'?'bg-red-500/[0.02]':'',strike=s.badge==='merged'?'line-through text-zinc-500':'';
    return `<tr class="${rBg}"><td class="px-5 py-3.5"><div class="rank-num ${rc}">${rank}</div></td><td class="px-4 py-3.5"><a href="${s.url}" target="_blank" rel="noopener" class="table-link font-medium whitespace-nowrap ${strike}">${s.name} <span class="link-arrow">→</span></a></td><td class="px-4 py-3.5">${tL}</td><td class="px-4 py-3.5 text-center"><span class="safety-dot ${sd}"></span></td><td class="px-4 py-3.5"><div class="mx-auto w-12"><div class="bar-fill bg-${bc}-500/70" data-width="${s.lib}" style="width:0"></div></div></td><td class="px-4 py-3.5 text-center"><span class="font-mono text-lg font-bold ${sclr}">${s.score}</span></td><td class="px-4 py-3.5 text-xs text-zinc-500">${s.notes}</td></tr>`;
}

function buildRankingSection(cat){
    const m=catMeta[cat],cs=cat==='all'?sites:sites.filter(s=>s.cat===cat);
    const ranked=[...cs].sort((a,b)=>b.score-a.score);
    const tbody=ranked.map((s,i)=>buildRankRow(s,i)).join('');
    const showCat=cat!=='all';
    return `<button id="rt-${cat}" class="lb-toggle w-full bg-white/[0.03] border border-white/[0.06] rounded-2xl p-5 md:p-6 flex items-center justify-between cursor-pointer text-left transition-all hover:border-white/[0.12]" onclick="toggleRanking('${cat}')"><div class="relative z-10 flex items-center gap-4"><div class="w-10 h-10 rounded-xl bg-gradient-to-br from-${m.color}-500/20 to-${m.color}-600/10 border border-${m.color}-500/20 flex items-center justify-center shrink-0"><span class="iconify text-${m.color}-400 text-lg" data-icon="${m.icon}"></span></div><div><h3 class="text-base font-semibold tracking-tight">${m.label}</h3><p class="text-zinc-500 text-xs mt-0.5">${cs.length} sites ranked by score · Click any name to visit</p></div></div><div class="relative z-10 flex items-center gap-3"><span id="tl-${cat}" class="hidden sm:inline-flex font-mono text-[10px] uppercase tracking-widest text-zinc-500 border border-zinc-800 rounded-full px-3 py-1">Show</span><span class="iconify toggle-icon text-zinc-400 text-xl" data-icon="mdi:chevron-down"></span></div></button><div id="rb-${cat}" class="ranking-body -mt-2"><div class="bg-white/[0.03] border border-white/[0.06] border-t-0 rounded-b-2xl overflow-hidden"><div class="overflow-x-auto"><table class="rank-table w-full text-sm"><thead><tr class="border-b border-white/[0.08]"><th class="text-left font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-5 py-4 w-14">#</th><th class="text-left font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4">Site</th>${showCat?'':`<th class="text-left font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4">Cat</th>`}<th class="text-left font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4">Status</th><th class="text-center font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4 w-14">Safe</th><th class="text-center font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4 w-14">Lib</th><th class="text-center font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4 w-16">Score</th><th class="text-left font-mono text-[10px] uppercase tracking-widest text-zinc-500 px-4 py-4 min-w-[160px]">Notes</th></tr></thead><tbody class="divide-y divide-white/[0.04]">${tbody}</tbody></table></div></div></div>`;
}

function populateGrids(){
    document.getElementById('grid-all').innerHTML=sites.map(buildCard).join('');
    document.getElementById('grid-anime').innerHTML=sites.filter(s=>s.cat==='anime').map(buildCard).join('');
    document.getElementById('grid-series').innerHTML=sites.filter(s=>s.cat==='series').map(buildCard).join('');
    document.getElementById('grid-kdrama').innerHTML=sites.filter(s=>s.cat==='kdrama').map(buildCard).join('');
    document.getElementById('grid-games').innerHTML=sites.filter(s=>s.cat==='games').map(buildCard).join('');
    document.getElementById('grid-downloads').innerHTML=sites.filter(s=>s.cat==='downloads').map(buildCard).join('');
    ['all','anime','series','kdrama','games','downloads'].forEach(cat=>{document.getElementById('ranking-section-'+cat).innerHTML=buildRankingSection(cat)});
}

let currentTab='all';
document.getElementById('tabBar').addEventListener('click',e=>{
    const btn=e.target.closest('.tab-btn');if(!btn)return;
    const tab=btn.dataset.tab;if(tab===currentTab)return;currentTab=tab;
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');
    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
    document.getElementById('panel-'+tab).classList.add('active');
    applySearch(document.getElementById('searchInput').value);
});

function applySearch(q){
    q=q.toLowerCase().trim();
    ['all','anime','series','kdrama','games','downloads'].forEach(p=>{
        const grid=document.getElementById('grid-'+p),empty=document.getElementById('empty-'+p);let vis=0;
        grid.querySelectorAll('.site-card').forEach(c=>{const match=!q||c.dataset.name.includes(q)||c.textContent.toLowerCase().includes(q);c.style.display=match?'':'none';if(match)vis++});
        if(empty)empty.classList.toggle('show',vis===0&&q);
    });
    const sc=document.getElementById('searchCount');
    if(q){const g=document.getElementById('grid-'+currentTab);const v=g.querySelectorAll('.site-card[style=""], .site-card:not([style])').length;sc.textContent=v+' found';sc.classList.remove('hidden')}else sc.classList.add('hidden');
}
document.getElementById('searchInput').addEventListener('input',e=>applySearch(e.target.value));

function toggleRanking(cat){
    const btn=document.getElementById('rt-'+cat),body=document.getElementById('rb-'+cat),label=document.getElementById('tl-'+cat);
    const isOpen=body.classList.contains('open');
    if(isOpen){body.classList.remove('open');btn.classList.remove('open');label.textContent='Show'}
    else{body.classList.add('open');btn.classList.add('open');label.textContent='Hide';setTimeout(()=>{body.querySelectorAll('.bar-fill[data-width]').forEach(bar=>{bar.style.width=bar.dataset.width+'%'})},200)}
}

function scrollToTop(){window.scrollTo({top:0,behavior:'smooth'})}
populateGrids();
</script>
</body>
</html>
